// Funcion para calcular el promedio general 
float calcularPromedioGeneral(struct Estudiante estudiantes[], int cantidad) {
    float suma = 0;
    for(int i = 0; i < cantidad; i++) {
        suma += estudiantes[i].promedio;
    }
    return suma / cantidad;
} 

// Funcion para encontrar al estudiante con mejor promedio
int encontrarMejorPromedio(struct Estudiante estudiantes[], int cantidad) {
    int indiceMejor = 0;
    for(int i = 1; i < cantidad; i++) {
        if(estudiantes[i].promedio > estudiantes[indiceMejor].promedio) {
            indiceMejor = i;
        }
    }
    return indiceMejor;
}

// Funcion para guardar datos en archivo 
void guardarEnArchivo(struct Estudiante estudiantes[], int cantidad) {
    FILE *archivo = fopen("estudiantes.txt", "w");
    if(archivo == NULL) {
        printf("Error al crear el archivo.\n");
        return;
    }

    for(int i = 0; i < cantidad; i++) {
        fprintf(archivo, "%s\n%d\n%.2f\n", estudiantes[i].nombre, estudiantes[i].edad, estudiantes[i].promedio)

    }

    fclose(archivo);
    printf("Datos guardados en 'estudiantes.txt'\n");

}

// Funcion para cargar datos desde archivo
int cargarDesdeArchivo(struct Estudiante estudiantes[], int maxCantidad) {
    FILE *archivo = fopen("estudiantes.txt", "r");
    if(archivo == NULL) {
        printf("No se encontro archivo para cargar.\n");
        return 0;
    }

    int cantidad = 0;
    while(cantidad < maxCantidad && fgets(esrudiantes[cantidad].nombre, 50, archivo) != NULL) {

        //Eliminar salto de linea del nombre
        estudiantes[cantidad].nombre[strcspn(estudiantes[cantidad].nombre, "\n")] = 0;

        fscanf(archivo, "%d", &estudiantes[cantidad].edad);
        fscanf(archivo, "%f", &estudiantes[cantidad].promedio);
        fgetc(archivo); 

        cantidad++;
    }
    fclose(archivo);
    printf("Datos cargados desde 'estudiantes.txt'\n");
    return cantidad;
}

int main() {
    struct Estudiante estudiantes[3];
    int opcion;
    int cantidad_estudiantes = 0;

    //Nuevo sistema de menu interactivo
    do {
       printf("\n=== SISTEMA DE ESTUDIANTES ===\n");
       printf("1. Capturar nuevos estudiantes\n");
       printf("2. Cargar datos desde archivo\n");
       printf("3. Mostrar estudiantes\n");
       printf("4. Calcular promedio general\n");
       printf("5. Mostrar mejor promdeio\n");
       printf("6. Guardar datos en archivo\n");
       printf("7. Salir\n");
       printf("Seleccione una opcion: ");
       scanf("%d", &opcion);
       getchar(); //Para limpiar buffer

       switch(opcion) {
           case 1: // CAPTURAR NUEVOS ESTUDIANTES
               printf("\n --- Captura de 3 estudiantes ---\n");
               for(int i = 0; i < 3; i++) {
                   printf("\nEstudiante #%d:\n", i + 1);

                   printf(" Nombre ");
                   fgets(estudiantes[1].nombre, 50, stdin);
                   estudiantes[i].nombre[strcspn(estudiantes[i].nombre, "\n")] = 0;

                   printf(" Edad ");
                   scanf("%d", &estudiantes[i].edad);

                   printf(" Promedio: ");
                   scanf("%f", &estudiantes[i].promedio);
                   getchar();
               }
               cantidad_estudiantes + 3;
               break;
            case 2: // CARGAR DESDE ARCHIVO 
                cantidad_estudiantes = cargarDesdeArchivo(estudiantes, 3);
                break;
                
            case 3: // MOSTRAR ESTUDIANTES
                if(cantidad_estudiantes == 0) {
                    printf("\nNo hay datos para mostrar.\n");
                } else {
                    printf("\n--- Lista de Estudiantes ---\n");
                    for(int i = 0; i < cantidad_estudiantes; i++) {
                        printf("\nEstudiante %d:\n", i + 1);
                        printf(" Nombre: %s\n", estudiantes[i].nombre);
                        printf(" Edad: %d años\n", estudiantes[i].edad);
                        printf(" Promedio: %.2f\n", estudiantes[i].promedio);
                    }
                }
                break;
            case 4: // CALCULAR PROMEDIO GENERAL
                if(cantidad_estudiantes == 0) {
                    printf("\nNohay datos para calcular.\n");
                } else {
                    float promedio_grupo = calcularPromedioGeneral(estudiantes, cantidad_estudiantes);
                    printf("\n--- Promedio General del Grupo ---\n");
                    printf("Promedio: %.2f\n", promedio_grupo);
                }    
                break;
            case 5: // MOSTRAR MEJOR PROMEDIO
                if(cantidad_estudiantes == 0) {
                    printf("\nNo hay datos por mostrar.\n");
                } else {
                    int indice_mejor = encontrarMejorPromedio(estudiantes, cantidad_estudiantes);
                    printf("\n--- Estudiante con Mejor Promedio ---\n");
                    printf("Nombre: %s\n", estudiantes[indice_mejor].nombre);
                    printf("Edad: %d años\n", estudiantes[indice_mejor].edad);
                    printf("Promedio: %.2f\n", estudiantes[indice_mejor].promedio);
                }
                break;
                
            case 6: // GUARDAR EN ARCHIVO
                if(cantidad_estudiantes == 0) {
                    printf("\nNo hay datos para guardar.\n");
                } else {
                    guardarEnArchivo(estudiantes, cantidad_estudiantes);
                }
                break;

            case 7: // SALIR
            printf("\nSaliendo del programa...\n");
            break;
            
        default:
        printf("\nOpcion no valida.\n");
        }
    } while(opcion != 7);
    
    return 0;
}    
