    // Funcion para cargar datos desde archivo
int cargarDesdeArchivo(struct Estudiante estudiantes[]) {
    FILE *archivo = fopen("estudiantes.txt", "r");
    if(archivo == NULL) {
        printf("No se encontró archivo para cargar.\n");
        return 0;
    }
    
    int cantidad = 0;
    char linea[100];
    
    while(cantidad < 10 && fscanf(archivo, "%d", &estudiantes[cantidad].matricula) != EOF) {
        fgetc(archivo); // Leer el salto de línea
        
        fgets(estudiantes[cantidad].nombre, 50, archivo);
        estudiantes[cantidad].nombre[strcspn(estudiantes[cantidad].nombre, "\n")] = 0;
        
        fscanf(archivo, "%d", &estudiantes[cantidad].edad);
        fgetc(archivo);
        
        fscanf(archivo, "%f", &estudiantes[cantidad].promedio);
        fgetc(archivo);
        
        for(int j = 0; j < 3; j++) {
            fgets(estudiantes[cantidad].materias[j].nombre, 30, archivo);
            estudiantes[cantidad].materias[j].nombre[strcspn(estudiantes[cantidad].materias[j].nombre, "\n")] = 0;
            
            fscanf(archivo, "%f", &estudiantes[cantidad].materias[j].calificacion);
            fgetc(archivo);
        }
        
        fgets(linea, 100, archivo); // Leer separador "---"
        
        cantidad++;
    }
    
    fclose(archivo);
    printf("Datos cargados desde 'estudiantes.txt' (%d estudiantes)\n", cantidad);
    return cantidad;
}

